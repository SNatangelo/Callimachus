.DS_Store
*.local

# Environment / secrets — never commit
.env
.env.*
*.env
!.env.example

# Runtime state / caches
/storage/
core/storage/
core/content_store/
/runs/
/browser_profiles/
/benchmarks/

# Python
__pycache__/
*.pyc

# Test paper / manuscript files — not part of the codebase
Paper test/

.claude/
.codex/
/.agents/skills/
.codex-owned-files.md
.pytest_cache/

# Temporary regression runs and their recovered source documents
*-regression-codex/
*-regression-codex-*/
*-with-config/
*-tmp-codex/
PARSER_REWORK_PLAN.md

# Local project memory and temporary planning
/knowledge/
/piani/
/tests_tenere/
/VERIFY_V25_SEMANTIC_CONTRACT_RESET_PLAN.md

# Generated developer and verification artefacts
/graphify-out/
/.verify-out/
/.pytest-tmp/
/pytest-of-*/
/.codex-tmp/
/citation-verifier-test-*/

# In-repository worktree containers
/.worktrees/
/build/desktop/
/codex-worktrees/
/claude-worktrees/
/worktree-archive-*/
/.deps/
/.local-review/
/.pytest-tmp-*/

# Local design proposals, reviews and test PDFs; excluded from pull requests.
/docs/design/atlante-2.0/

# Preserved local native toolchains and verified dependency artifacts
/build-cache/
/build/security-audit/

/build/security-cryptography/
/build/security-pillow/
