# .env.example
# Copyright (C) 2026 Stefano Natangelo
# SPDX-License-Identifier: AGPL-3.0-only
# Citation Verifier — local configuration.
# Copy to .env (git-ignored) and fill in. Load with:  set -a; . ./.env; set +a
# Complete label reference: docs/guide/11-environment-reference.md
# Key creation and storage: docs/guide/10-keys-and-credentials.md
#
# Sections below:
#   1. Core run settings        — regime, contact email, OCR, table citations
#   2. Final Verify runtime     — the LLM jury that judges axis 3 (REQUIRED to verify)
#   3. LLM provider credentials — API keys / endpoints / per-provider models
#   4. Final Verify tuning      — context, pacing, retries, cooldown (sensible defaults)
#   5. Content / resolver keys  — Google Books, CORE, Elsevier, NCBI, Semantic Scholar, Lens, Wiley TDM, Springer Nature
#   6. HTTP / fetch settings    — user-agent, profile, workers, timeouts
#   7. Report signing           — HMAC key (deployment "cage"; hook/CI side only)
#   8. Diagnostics              — debug + perf toggles
#   9. Bibliographic registries — journal authority + dated resolver coverage
#
# Section 2 and the credentials/models for its selected backends in section 3
# are required to run verification (axis 3). Other values are optional or
# provider-specific; the full reference identifies three currently inert labels.


# =============================================================================
# 1. Core run settings
# =============================================================================

# Verification regime (accuracy grade). One of:
#   maximum          = full text only; a missing full text leaves the source unverified
#   maximum_fallback = full text; abstract read provisionally when existence is unknown
#   standard         = full text preferred, abstract fallback on paywall (default)
#   abstract         = abstract-level checking (full text not chased)
#   standard_web     = standard + post-verify web research as a last resort
CITATION_VERIFIER_ACCURACY=standard

# Contact email for Crossref / Europe PMC / Unpaywall etiquette and rate limits.
# Sent in request headers (that is the point); never written to the report.
# Leave empty to run without it (APIs may rate-limit).
CITATION_VERIFIER_MAILTO=

# OCR language(s) for scanned manuscripts and cited PDFs.
# Passed to the OCR backend, e.g. 'eng' or 'eng+ita'. Default: eng.
CITATION_VERIFIER_OCR_LANG=eng

# Automatically OCR cited PDFs whose extracted text is too short.
# Enabled by default; set 0 to require an explicit OCR task instead.
CITATION_VERIFIER_OCR_AUTO=1

# Maximum page count eligible for unattended automatic OCR (default 50;
# values below 1 are clamped to 1, invalid values use the default).
CITATION_VERIFIER_OCR_AUTO_MAX_PAGES=50

# Process-wide OCR concurrency (default 1; minimum 1). Increase only after
# validating that the selected OCR backend is safe under concurrent inference.
CITATION_VERIFIER_OCR_WORKERS=1

# Include citations that occur only in tables as claims (1/true/yes/on).
# Disabled by default because many table cells do not express a claim.
CITATION_VERIFIER_VERIFY_TABLE_CITATIONS=0


# =============================================================================
# 2. Final Verify runtime  (the axis-3 jury — REQUIRED to verify)
# =============================================================================
# Axis 3 ("does the source support the claim?") is judged by the claim-evidence
# runtime: jury1 proposes an outcome + verbatim evidence, a deterministic grounding
# check rejects any quote not found in the source, and an optional jury2 re-judges
# the claim against ONLY the extracted evidence. Both knobs below are mandatory —
# no provider is auto-selected and jury2 has no default.

# REQUIRED. Explicit registered providers (CSV, tried in order). Examples:
#   openai | anthropic | gemini | openai_compatible | glm | mistral |
#   opencode | ollama | freetoken | openrouter | claude_cli | codex_cli |
#   gemini_cli | host
# The *_cli backends reuse an existing agent login (no API key). Leave empty and
# the run stops before verifying.
CITATION_VERIFIER_VERIFY_BACKENDS=

# REQUIRED. Second-judge (jury2) enforcement level: off | low | medium | high.
#   off    = no second judge
#   low    = accept a refuted verdict anyway, flagged + reliability downgraded
#   medium = re-verify up to the retry budget; on exhaustion accept only if the
#            majority of jury1 attempts passed, else mark the pair uncertain
#   high   = like medium but never falls back to a majority accept (→ uncertain)
CITATION_VERIFIER_VERIFY_JURY2_LEVEL=

# Generic model CSV fallback. A provider-specific model CSV (section 3) wins when set.
# The current policy also requires a model for CLI and host backends.
CITATION_VERIFIER_MODEL=

# Aggregate in-flight cap across all jury stages / providers / models / credentials.
CITATION_VERIFIER_VERIFY_MAX_IN_FLIGHT=4

# Per-call output budget and reasoning controls. Use none to omit the token field
# on a backend that explicitly supports provider-managed output limits.
CITATION_VERIFIER_VERIFY_MAX_TOKENS=4000
CITATION_VERIFIER_REASONING=auto
CITATION_VERIFIER_REASONING_EFFORT=medium

# Bounded controller and per-stage transport retry budgets.
CITATION_VERIFIER_VERIFY_MAX_CANDIDATE_CYCLES=5
CITATION_VERIFIER_VERIFY_JURY1_MAX_TECHNICAL_ATTEMPTS=3
CITATION_VERIFIER_VERIFY_JURY2_MAX_TECHNICAL_ATTEMPTS=3

# Optional provider:model role exclusions (restrict a provider to one jury stage).
CITATION_VERIFIER_VERIFY_JURY1_ONLY=
CITATION_VERIFIER_VERIFY_JURY2_ONLY=


# =============================================================================
# 3. LLM provider credentials  (fill in only the backend(s) named above)
# =============================================================================

# OpenAI (direct)
OPENAI_API_KEY=

# Anthropic API (direct).
# The transport tries ANTHROPIC_API_KEY first, then ANTHROPIC_AUTH_TOKEN, but the
# current declarative Verify policy still requires ANTHROPIC_API_KEY.
# For local endpoints (e.g. http://127.0.0.1:8082), set ANTHROPIC_BASE_URL.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# OpenRouter
OPENROUTER_API_KEY=

# TypeSafe AI (Jev System One)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
# TypeSafe's Choice confidence (and Noul certainty for evidence spans) is an
# auto-action floor, not a probability that a citation is correct.  Below it,
# Callimachus records an explicit non-crediting provider abstention without a
# technical retry; a Jury2 abstention asks Jury1 for another candidate until
# the bounded candidate cap.  0.8 is TypeSafe's conservative floor pending a
# Callimachus calibration set; override only with a documented calibration.
# Jev remains configurable for Jury1, but the current Attention canary ended
# 57/58 pairs uncertain at this floor.  Prefer a Jury2-only selector when a
# separate Jury1 lane is available; see the verification guide.
TYPESAFE_MIN_CONFIDENCE=0.8

# Ollama (local http://localhost:11434, or cloud via OLLAMA_API_KEY).
# The current declarative policy requires a non-empty OLLAMA_API_KEY lane even
# for local Ollama; see docs/guide/10-keys-and-credentials.md.
OLLAMA_API_KEY=
OLLAMA_HOST=

# FreeToken — credentialless local OpenAI-compatible server.
#   Enable with CITATION_VERIFIER_VERIFY_BACKENDS=freetoken.
#   FREETOKEN_HOST is the server root, without /v1; empty uses
#   http://127.0.0.1:1919. Model: FREETOKEN_MODEL (or CITATION_VERIFIER_MODEL).
# Callimachus does not install, start, or auto-discover a model from FreeToken.
FREETOKEN_HOST=
FREETOKEN_MODEL=

# Claude CLI — uses your existing Anthropic login (claude in PATH, no API key needed).
# Enable with CITATION_VERIFIER_VERIFY_BACKENDS=claude_cli.

# DeepSeek / OpenAI-compatible (DeepSeek, Together, vLLM, llama.cpp, …).
#   Enable with CITATION_VERIFIER_VERIFY_BACKENDS=openai_compatible.
#   Model: OPENAI_MODEL (or CITATION_VERIFIER_MODEL).
# Leave OPENAI_BASE_URL empty for the real OpenAI API; set it to a third-party
# endpoint (e.g. https://api.deepseek.com) to use openai_compatible.
OPENAI_BASE_URL=
OPENAI_MODEL=

# GLM (ZhipuAI / z.ai) — OpenAI-compatible chat completions API.
#   Enable with CITATION_VERIFIER_VERIFY_BACKENDS=glm.
#   Model: ZHIPUAI_MODEL (or CITATION_VERIFIER_MODEL).
ZHIPUAI_API_KEY=
ZHIPUAI_MODEL=

# Mistral AI (https://api.mistral.ai/v1).
#   Enable with CITATION_VERIFIER_VERIFY_BACKENDS=mistral.
#   Model: MISTRAL_MODEL (or CITATION_VERIFIER_MODEL).
MISTRAL_API_KEY=
MISTRAL_MODEL=

# OpenCode Zen (https://opencode.ai — requires active billing for API access).
#   Enable with CITATION_VERIFIER_VERIFY_BACKENDS=opencode.
#   Model: OPENCODE_MODEL (or CITATION_VERIFIER_MODEL).
OPENCODE_API_KEY=
OPENCODE_MODEL=

# Host bridge — the orchestrator processes LLM requests via an external command.
#   Enable with CITATION_VERIFIER_VERIFY_BACKENDS=host.
CITATION_VERIFIER_LLM_HOST_COMMAND=

# OpenRouter attribution headers (optional).
CITATION_VERIFIER_OPENROUTER_SITE_URL=
CITATION_VERIFIER_OPENROUTER_APP_NAME=


# =============================================================================
# 4. Final Verify tuning  (defaults are sensible; override only if needed)
# =============================================================================

# Immutable context selection for the jury.
#   CONTEXT_MODE:    auto | full_text | extractive_rag
#   CONTEXT_PROFILE: large | medium | small
#   MAX_SOURCE_CHARS: positive frozen budget; required for extractive_rag and
#                     auto medium/small (install requirements-rag.txt if RAG is selected)
CITATION_VERIFIER_VERIFY_CONTEXT_MODE=auto
CITATION_VERIFIER_CONTEXT_PROFILE=large
CITATION_VERIFIER_MAX_SOURCE_CHARS=

# Dispatch-start pacing (rate-shaping). Zero is the frozen no-delay default.
CITATION_VERIFIER_VERIFY_PACING_INTERVAL_MS=0
CITATION_VERIFIER_VERIFY_PACING_BY_MODEL_MS=

# Deterministic seeded candidate selection; blank derives it from the run and
# the frozen policy hash.
CITATION_VERIFIER_VERIFY_SELECTION_SEED=

# Persisted 429 cooldown policy.
CITATION_VERIFIER_VERIFY_COOLDOWN_SECONDS=5
CITATION_VERIFIER_VERIFY_COOLDOWN_OVERRIDES=
CITATION_VERIFIER_VERIFY_COOLDOWN_MULTIPLIER=2
CITATION_VERIFIER_VERIFY_COOLDOWN_MAX_SECONDS=300
CITATION_VERIFIER_VERIFY_COOLDOWN_STABLE_SUCCESSES=2

# =============================================================================
# 5. Content / resolver API keys  (optional; improve existence + retrieval)
# =============================================================================

# Google Books API key — unlocks opt-in preview snippets for books.
# Leave empty to disable the book preview tier.
GOOGLE_BOOKS_API_KEY=

# CORE API key — enables OA discovery and direct API full text.
CORE_API_KEY=

# Zenodo access token — enables conservative publication-copy fallback after VoR/OA lookup.
# Treat this as a secret; it is sent only as an Authorization header.
ZENODO_ACCESS_TOKEN=

# Elsevier API key — enables DOI/PII Article API retrieval when the key and
# account have the required full-text entitlement.
ELSEVIER_API_KEY=

# Wiley TDM token — enables DOI-targeted PDF retrieval for catalog-routed Wiley works.
# Obtain it from https://onlinelibrary.wiley.com/library-info/resources/text-and-datamining
# Treat this as a secret. No extra package is required; Wiley still checks IP-based entitlement.
TDM_API_TOKEN=

# Springer Nature Meta API key — enriches catalog-routed, DOI-identified works.
# Obtain it from https://dev.springernature.com/
# Treat this as a secret. No extra package is required.
SPRINGER_NATURE_META_API_KEY=

# Springer Nature Open Access API key — retrieves DOI-exact open-access JATS full text.
# Obtain it from https://dev.springernature.com/
# Treat this as a secret. No extra package is required.
SPRINGER_NATURE_OPEN_ACCESS_API_KEY=

# NCBI E-utilities API key — raises the shared NCBI request rate from 3/s to 10/s.
# Obtain one from https://www.ncbi.nlm.nih.gov/account/settings/
# Leave empty to use NCBI's keyless 3/s limit. ENTREZ_API_KEY remains a supported alias.
NCBI_API_KEY=
ENTREZ_API_KEY=

# OpenAlex API key — optional authenticated Resolve and Fetch requests.
OPENALEX_API_KEY=

# Semantic Scholar API key — optional title-search resolver fallback.
SEMANTIC_SCHOLAR_API_KEY=

# Lens.org scholarly API token — optional title-search resolver fallback.
LENS_API_KEY=

# Optional local/self-hosted biblio-glutton resolver, e.g. http://localhost:8080.
# Not a secret. Leave blank: there is no public-demo fallback.
BIBLIO_GLUTTON_URL=

# CourtListener API token — confirms a US case exists from its reporter citation
# ("576 U.S. 644"). Token from https://www.courtlistener.com/profile/api-token/
# Leave empty to skip case-law resolution entirely.
COURTLISTENER_API_TOKEN=

# Optional deterministic web-search providers. Empty keys make their backend
# stand down; the configured backend chain may continue to another provider.
TAVILY_API_KEY=
MOJEEK_API_KEY=


# =============================================================================
# 6. HTTP / fetch settings  (optional; tune throughput and publisher access)
# =============================================================================

# HTTP User-Agent override for publisher-facing fetches.
CITATION_VERIFIER_USER_AGENT=

# HTTP request profile: plain | browser_like. Runtime default when unset is
# browser_like; this template deliberately pins plain when copied verbatim.
CITATION_VERIFIER_HTTP_PROFILE=plain

# Challenge-page handling. Common values: off | queue | interactive_challenge |
# interactive_closed | interactive_fallback | interactive_fallback_closed.
# See the environment reference for aliases and dependency requirements.
CITATION_VERIFIER_FETCH_CHALLENGE_MODE=off

# Guided Fetch fallback search used only when Resolve has no concrete source URL.
# URL must include exactly the {query} placeholder. Query fields may be any of:
# {raw_entry}, {title}, {doi}, {pmid}, {isbn}, {year}, {ay_surname}, {source_type}.
CITATION_VERIFIER_GUIDED_SEARCH_URL=https://www.google.com/search?q={query}
CITATION_VERIFIER_GUIDED_SEARCH_QUERY={raw_entry}

# Extra fetch providers: auto | comma-separated module names.
CITATION_VERIFIER_FETCH_PROVIDERS=auto
CITATION_VERIFIER_FETCH_PROVIDER_ORDER=

# Consult alternate open-access candidates. Enabled by default; only
# 0/false/no disables this second acquisition round.
CITATION_VERIFIER_OA_ALTERNATES=1

# Consult archival acquisition paths. Enabled by default; set
# 0/false/no/off to disable either path.
CITATION_VERIFIER_WAYBACK=1
CITATION_VERIFIER_PERMA=1

# Parallel fetch workers (sources fetched concurrently in the fetch phase).
# Default: 4. Range: 1-16. Higher can speed up large runs if targets allow it.
CITATION_VERIFIER_FETCH_WORKERS=

# Parallel resolve workers (references resolved concurrently in the resolve
# phase). Default scales with bibliography size (4 for small runs, up to 16).
# Override to a fixed count:
CITATION_VERIFIER_RESOLVE_WORKERS=

# Per-PDF download timeout, in seconds (default 45; clamped to 5-300).
CITATION_VERIFIER_FETCH_PDF_TIMEOUT=

# Per-reference fetch wall-clock budget, in seconds (default 120; 0 = unlimited).
# Once spent, the preprint fetch stage for that reference is skipped and the
# reference stays retryable (not marked a permanent failure).
CITATION_VERIFIER_FETCH_BUDGET_S=


# =============================================================================
# 7. Report output and signing
# =============================================================================

# Generate the sealed, self-contained report.html after the canonical report
# gate passes. Enabled by default; set 0/false/no/off to disable generation.
CITATION_VERIFIER_REPORT_HTML=1

# Signing key path for HMAC report sealing (generated by `run.py configure --gen-key`).
# Keep this OUT of the agent's shell: it belongs only to the Stop hook / CI
# environment so a report cannot be forged. Do not set it in this project .env;
# follow docs/guide/10-keys-and-credentials.md and DEPLOYMENT.md.
CITATION_VERIFIER_SIGNING_KEY_FILE=


# =============================================================================
# 8. Diagnostics  (opt-in; near-zero cost when unset)
# =============================================================================

# Force debug event capture (1/true/yes/on).
CITATION_VERIFIER_DEBUG_RUN=

# Performance timing collector. When enabled, persists a typed snapshot in
# run.sqlite and prints a per-phase timing table at the end of `python run.py`.
CITATION_VERIFIER_PERF=

# In-run HTTP GET memoization: dedupe identical read-only API GETs within one run.
CITATION_VERIFIER_HTTP_MEMO=


# =============================================================================
# 9. Bibliographic registries
# =============================================================================

# Local SQLite journal registry managed by `run.py journal-catalog`.
# The default public NLM source needs no credential. Automatic network refresh is
# opt-in; an invalid catalog fails closed and is never overwritten automatically.
CALLIMACHUS_JOURNAL_AUTHORITY_DB=
CALLIMACHUS_JOURNAL_AUTHORITY_AUTO_UPDATE=0
CALLIMACHUS_JOURNAL_AUTHORITY_TTL_DAYS=7

# Dated resolver-by-journal coverage observations. Empty uses
# storage/resolver-coverage.sqlite. A stale or failed observation never strengthens
# a verdict; automatic refresh occurs after the positive TTL below.
CALLIMACHUS_RESOLVER_COVERAGE_DB=
CALLIMACHUS_RESOLVER_COVERAGE_TTL_DAYS=30
